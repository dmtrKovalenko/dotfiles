{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-chrome-devtools"],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "fff": {
      "type": "local",
      "command": [
        "@@DOTFILES_HOME@@/.local/bin/fff-mcp"
      ],
      "enabled": false
    }
  }
}
