#!/bin/sh
# Reject co-authors other than gustav-fff.
if grep -v '^#' "$1" | "$(dirname "$0")/_blocked-coauthors"; then
  echo "commit-msg: only gustav-fff is allowed in Co-Authored-By trailers; remove other co-authors:" >&2
  grep -v '^#' "$1" | grep -i '^[[:space:]]*co-authored-by:' >&2
  exit 1
fi
exec "$(dirname "$0")/_chain" commit-msg "$@"
