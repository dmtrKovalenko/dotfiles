#!/bin/sh
# Refuse to push commits carrying a Co-Authored-By trailer other than gustav-fff (catches commits
# made via cherry-pick, rebase, --no-verify or other machines).
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
input=$(cat)
bad=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] || [ "$local_sha" = "$zero" ] && continue
  # Only commits no remote has yet: a rebase must not re-check what is already on main.
  for c in $(git rev-list "$local_sha" --not --remotes); do
    if git log -1 --format=%B "$c" | "$(dirname "$0")/_blocked-coauthors"; then
      echo "pre-push: $(git log -1 --format='%h %s' "$c") has a disallowed Co-Authored-By trailer (only gustav-fff is allowed)" >&2
      bad=1
    fi
  done
done <<IN
$input
IN
[ $bad -eq 1 ] && { echo "pre-push: push blocked. Reword those commits (git rebase -i) first." >&2; exit 1; }
printf '%s\n' "$input" | "$(dirname "$0")/_chain" pre-push "$@"
